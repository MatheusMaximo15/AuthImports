# Cabeçalhos de segurança do Cloudflare Pages (vale para todo o site).
# script-src precisa de 'unsafe-inline' porque as páginas têm scripts inline.
# Ao migrar para Astro, mover os scripts para arquivo e tirar o 'unsafe-inline'.
# frame-ancestors 'self' (e não 'none'): bloqueia outros sites de embutir a página
# e ainda deixa o próprio site em iframe, que a medição de layout usa.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
